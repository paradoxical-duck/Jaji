# Firebase web configuration is public by design, but environment variables make it easy
# to point preview and production builds at different projects.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_AUTH_EMAIL_ENDPOINT=https://jaji-auth.netlify.app/.netlify/functions/send-email-sign-in-link
